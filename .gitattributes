# Fine-tuned triage encoder weights (~90 MB) go to Git LFS, not plain git.
# After cloning, run `git lfs pull` before building the backend image.
backend/models/triage/encoder/*.safetensors filter=lfs diff=lfs merge=lfs -text
# Fine-tuned ContextDefender encoder (~90 MB), same rule as the triage encoder.
backend/models/security/encoder/*.safetensors filter=lfs diff=lfs merge=lfs -text
# Llama Prompt Guard 2 weights (Llama 4 Community License; LICENSE and NOTICE ship beside them).
backend/models/security/prompt_guard/*.safetensors filter=lfs diff=lfs merge=lfs -text
# ContextDefender train/test/probe data (~41 MB of public-dataset text, including attack examples); see
# backend/data/security/README.md for sources and licences.
backend/data/security/*.jsonl filter=lfs diff=lfs merge=lfs -text
# Checkpoint 2 alignment classifier data and model (planning/specs/checkpoint2-intent/). Rows from gated
# and no-train sources live only in the git-ignored alignment/local/ folder.
backend/data/security/alignment/**/*.jsonl filter=lfs diff=lfs merge=lfs -text
backend/models/security/alignment/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
backend/models/security/alignment/**/*.pt filter=lfs diff=lfs merge=lfs -text
