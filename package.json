{
  "name": "webagent-platform",
  "version": "3.10.0",
  "description": "WebAgent multi-agent research platform: Next.js web app and FastAPI/LangGraph backend",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:local": "next start -p 3001",
    "test": "jest",
    "test:coverage": "jest --ci --coverage",
    "test:backend": "conda run -n agents python -m pytest backend/tests -q",
    "coverage:backend": "conda run -n agents python -m pytest backend/tests -q --cov=backend/app --cov-report=term-missing:skip-covered",
    "stack:up": "APP_VERSION=$npm_package_version docker compose -f backend/docker-compose.yml --env-file .env.local up --build",
    "stack:down": "docker compose -f backend/docker-compose.yml --env-file .env.local down",
    "lint": "eslint .",
    "lint:backend": "conda run -n agents ruff check backend",
    "check-types": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prepare": "husky install",
    "diagnostics": "conda run -n agents python -m backend.diagnostics.runners.run_diagnostics",
    "tests": "conda run -n agents python -m backend.diagnostics.runners.run_tests",
    "check": "conda run -n agents python -m backend.diagnostics.runners.run_all",
    "research": "conda run -n agents python scripts/run_webagent.py --mode workflow",
    "vercel-build": "next build"
  },
  "dependencies": {
    "@heroicons/react": "^2.1.1",
    "file-saver": "^2.0.5",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@babel/plugin-transform-private-methods": "^7.29.7",
    "@babel/plugin-transform-private-property-in-object": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/eslintrc": "^3.3.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.1.6",
    "@testing-library/react": "^16.3.3",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "husky": "^8.0.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-watch-typeahead": "^2.2.2",
    "lint-staged": "^15.2.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.18"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
    }
  }
}
