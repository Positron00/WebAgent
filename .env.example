# Non-secret defaults (lowest priority). Copy to .env if you want to change them:
#   cp .env.example .env
# Put API keys in .env.local instead (see .env.local.example), which overrides this file.

WEBAGENT_ENV=dev
WEBAGENT_API_PORT=8000
WEBAGENT_CORS_ORIGINS=http://localhost:3000
WEBAGENT_BACKEND_URL=http://127.0.0.1:8000
