# WebAgent settings template.
# Copy to .env.local in the repo root and fill in your keys:
#   cp .env.local.example .env.local
# .env.local is git-ignored. Both the FastAPI backend and the Next.js app read it.
# Commented-out lines show the default used when the setting is left out.

# --- Environment -------------------------------------------------------------
# dev | uat | prod. Picks backend/config/{env}.yaml. uat/prod require the
# security keys below to be set. A WEBAGENT_ENV set in your shell or container
# takes precedence over this line (e.g. `WEBAGENT_ENV=prod python -m backend.main`).
WEBAGENT_ENV=dev

# --- LLM providers -----------------------------------------------------------
# Together AI is the default provider and is REQUIRED for the web app's chat.
TOGETHER_API_KEY=your_together_api_key
# Other providers are optional; they are tried in turn if Together fails.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Default model for the backend agents and the web app's chat.
# WEBAGENT_LLM_DEFAULT_PROVIDER=together
# WEBAGENT_LLM_DEFAULT_MODEL=meta-models/Muse-Glimmer-30B
# Per-provider model overrides
# TOGETHER_MODEL=meta-models/Muse-Glimmer-30B
# OPENAI_MODEL=gpt-4o-mini-2024-07-18
# ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
# GROQ_MODEL=llama-3.1-8b-instant
# GEMINI_MODEL=gemini-1.5-flash-002

# Minimum seconds between Together AI calls (temporary errors are retried 3 times).
# TOGETHER_RATE_LIMIT_SECONDS=2.0

# --- Web search --------------------------------------------------------------
# Needed for the web research agent.
TAVILY_API_KEY=your_tavily_api_key

# --- Tracing (LangSmith, optional) -------------------------------------------
# Tracing turns on when a key is set. These override any LANGSMITH_PROJECT /
# LANGSMITH_TRACING exported in your shell, so traces stay in one project.
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT_NAME=webagent-research
# LANGSMITH_TRACING_ENABLED=true

# --- Backend API security ----------------------------------------------------
# Key that clients (and the Next.js proxy) send as X-API-Key. Required in uat/prod.
WEBAGENT_API_KEY=
# JWT signing secret. Required in uat/prod (generate with: openssl rand -hex 48).
WEBAGENT_SECURITY_SECRET_KEY=
# Turned on by uat/prod YAML; set here to test API-key auth locally.
# WEBAGENT_SECURITY_API_KEY_ENABLED=false
# WEBAGENT_SECURITY_JWT_ENABLED=false

# --- Web app -> backend ------------------------------------------------------
# Where the Next.js /api/task proxy finds the FastAPI backend.
# WEBAGENT_BACKEND_URL=http://127.0.0.1:8000

# Default Agentic mode (off | auto | always) for people who haven't picked one; a
# mode someone picks is saved in their browser and wins. Re-read from this file on the
# next page load, with no restart. On Vercel or in Docker without .env.local on disk,
# it comes from the environment instead, and a change needs a redeploy or restart.
WEBAGENT_DEFAULT_AGENTIC_MODE=off

# --- Web app sign-in ---------------------------------------------------------
# The code people type at /login (at least 12 characters). Without it, development
# stays open (with a warning) and a production build answers 503 on every API route.
WEBAGENT_ACCESS_CODE=
# Signs the session cookie (at least 32 random characters: openssl rand -hex 32).
# Changing it signs everyone out.
WEBAGENT_SESSION_SECRET=
# true runs with no access code on purpose, also in production (for example behind
# your own sign-in proxy).
# WEBAGENT_ACCESS_CODE_DISABLED=false

# --- Agentic triage (backend) ------------------------------------------------
# Override the triage: section of backend/config/<env>.yaml. See backend/README.md.
# WEBAGENT_TRIAGE_ENABLED=true        # false: Auto acts like Always, model never loads
# WEBAGENT_TRIAGE_MODE=shadow         # dev YAML default; act stops shadow recording
# WEBAGENT_TRIAGE_COLLECT=true        # saves question text for review (dev only by default)
# WEBAGENT_TRIAGE_THRESHOLD=0.5       # overrides models/triage/metadata.json
# WEBAGENT_TRIAGE_LLM_TIEBREAK=false

# --- Agentic security guard --------------------------------------------------
# Checkpoints run in shadow by default in dev (see backend/config/dev.yaml).
# WEBAGENT_GUARD_ENABLED=true
# WEBAGENT_GUARD_INPUT_MODE=shadow   # shadow | act
# WEBAGENT_GUARD_TOOL_MODE=shadow
# WEBAGENT_GUARD_JUDGE=false         # LLM judge for verify at checkpoint 2
# WEBAGENT_GUARD_COLLECT=true        # off in uat/prod unless approved for review
# Signs consent/approval tokens (required when guard is on in uat/prod).
# WEBAGENT_SECURITY_SECRET_KEY=

# --- Server ------------------------------------------------------------------
# dev YAML listens on 127.0.0.1. In dev with API keys off, `python -m backend.main`
# refuses any other address unless WEBAGENT_ALLOW_OPEN_DEV=true.
# WEBAGENT_API_HOST=127.0.0.1
# WEBAGENT_ALLOW_OPEN_DEV=false
# WEBAGENT_API_PORT=8000
# WEBAGENT_API_DEBUG_MODE=false   # true also turns on auto-reload
# WEBAGENT_CORS_ORIGINS=http://localhost:3000

# Let agents run generated Python code inside the API server (off by default).
# WEBAGENT_ENABLE_CODE_EXECUTION=false
# Where generated code runs: local (no secrets in its environment, CPU/memory limits)
# or docker (no network, read-only container; required in uat/prod).
# Build the image with: docker build -t webagent/code-sandbox:latest backend/sandbox
# WEBAGENT_CODE_SANDBOX=local
# WEBAGENT_SANDBOX_IMAGE=webagent/code-sandbox:latest
# WEBAGENT_SANDBOX_MEMORY=512m
# Proxies trusted for per-user rate limiting: the backend takes their X-WebAgent-Client
# (the web app's sign-in session) or the right-most untrusted X-Forwarded-For address.
# Callers with a valid WEBAGENT_API_KEY (the web app on Vercel) are trusted the same way.
# WEBAGENT_TRUSTED_PROXIES=127.0.0.1,::1
# A research run is stopped after this many seconds (it normally takes 150-210).
# WEBAGENT_TASK_MAX_SECONDS=420
# Each Tavily search (with its retry) gives up after this many seconds.
# WEBAGENT_SEARCH_TIMEOUT_SECONDS=30
# A task still "processing" after this many minutes is reported as interrupted
# (a worker died). Keep it well above WEBAGENT_TASK_MAX_SECONDS.
# WEBAGENT_TASK_TIMEOUT_MINUTES=30
# Download missing NLTK data on first use (the Docker image ships it and sets false).
# WEBAGENT_NLTK_AUTO_DOWNLOAD=true
# Return a placeholder reply when every LLM provider fails (for offline testing).
# WEBAGENT_ALLOW_FAKE_LLM=false

# --- Data locations ----------------------------------------------------------
# WEBAGENT_DATA_DIR=backend/data          # also holds results/ (saved task reports)
# WEBAGENT_VECTOR_DB_PATH=backend/data/vectordb
# WEBAGENT_ARTIFACTS_PATH=backend/data/artifacts
# WEBAGENT_MODEL_REGISTRY_PATH=backend/data/registry/models_registry.json

# --- Monitoring (Grafana) ----------------------------------------------------
# Admin password for the Grafana that `npm run stack:up` (Docker Compose) and
# backend/kubernetes/deploy.sh start. Required by both; never commit it.
# Generate one with: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=
# Host port for the stack's Grafana (3000 is left for the Next.js dev server).
# GRAFANA_HOST_PORT=3001
# Where the backend reaches Grafana, and the service account token it uses to
# manage dashboards (Grafana > Administration > Service accounts).
# GRAFANA_URL=http://127.0.0.1:3000
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# --- MLflow (optional) -------------------------------------------------------
# MLFLOW_TRACKING_URI=http://127.0.0.1:8080
# MLFLOW_DEFAULT_ARTIFACT_ROOT=file:///path/to/WebAgent/backend/mlruns
