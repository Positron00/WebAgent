        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(model_predictions_total{model_id=~\"$model\"}) by (model_id)",
            "legendFormat": "{{model_id}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "blue",
                  "value": 0
                }
              ]
            },
            "unit": "none"
          },
          "overrides": []
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "text": {},
          "textMode": "auto"
        }
      },
      {
        "id": 4,
        "title": "Error Rate",
        "type": "gauge",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 8,
          "y": 8
        },
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(model_errors_total{model_id=~\"$model\"}) by (model_id) / sum(model_predictions_total{model_id=~\"$model\"}) by (model_id)",
