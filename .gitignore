# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.coverage
.coverage.*
htmlcov/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Backend runtime artifacts
logs/
backend/logs/
backend/**/*.log
backend/mlruns/
mlruns/
mlflow.db
backend/**/*.db
*.db-journal
mlruns/

# Generated Chroma / vector DB stores
backend/**/vectordb/

# Generated demo / test data (keep sample_docs)
backend/data/artifacts/
backend/data/results/
backend/data/registry/
backend/data/hf-cache/
backend/data/triage/collected/
backend/data/security/collected/
backend/data/security/escalations/
backend/data/security/tokens/
backend/demos/logs/
backend/demos/results/

# Backup files
*.bak
*.bak[0-9]*

# images
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff

# MLflow artifact store (generated)
mlartifacts/
